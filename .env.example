# ===== 简舜科技建站信息聚合平台 环境变量配置 =====
# 复制为 .env 后按需修改；AI/高德 Key 也可在网页端「AI 配置」中动态设置（优先级：网页配置 > 环境变量）

# 服务端口
PORT=3000

# AI 服务 API Key（可选，可在网页配置）
AI_API_KEY=

# AI 服务 API 地址（OpenAI 兼容接口）
AI_API_URL=https://api.openai.com/v1/chat/completions

# AI 模型名称
AI_MODEL=gpt-4o-mini

# 高德地图 Web 服务 Key（可选，可在网页配置）
AI_AMAP_KEY=

# 上传文件大小上限（MB）
MAX_UPLOAD_MB=50
